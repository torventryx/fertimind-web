# URL pública del sitio (canonical + sitemap)
NEXT_PUBLIC_SITE_URL=https://fertimind.es

# Firebase Admin (SSR). En Cloud Run usa ADC; en local apunta a la service account.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Opcional: reseñas de Google para el directorio de clínicas
# GOOGLE_PLACES_API_KEY=

# Opcional: ID de precio Stripe para el pago único (se crea al configurar Stripe)
# STRIPE_PRICE_ID=price_xxx
